# Copy this file to backend/.env and fill in the values. Never commit the real .env.

# Required: your OpenAI API key (set a monthly spend cap in the OpenAI dashboard).
OPENAI_API_KEY=

# Optional: comma-separated web addresses allowed to call the API.
# Leave unset for the defaults (local dev on port 5173 and the live site).
# ALLOWED_ORIGINS=http://localhost:5173,https://your-site.example

# Optional: seconds an upload lives before it is removed (default 1800).
# UPLOAD_TTL_SECONDS=1800

# Optional: folder for temporary uploads and the index (default backend/data).
# It is emptied every time the server starts, so use a dedicated folder.
# DATA_DIR=

# Optional: set to 1 to serve the /docs page.
# ENABLE_API_DOCS=1

# Testing only: set to 1 to use built-in stand-ins instead of OpenAI.
# The server refuses to start with this set on Render.
# FAKE_OPENAI=1
